# Somente credenciais públicas. Nunca coloque service_role ou secret aqui.
# Deixe em branco para usar o modo de demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: base dos tópicos MQTT. Vazio = tópicos originais do protótipo físico.
# Para testar o Wokwi sem misturar com a placa física, use a mesma base do config.h:
# VITE_MQTT_TOPIC_BASE=aquamonitor/demo-29out-b741d2/wokwi
# Nunca coloque usuário ou senha MQTT neste arquivo: elas são digitadas na tela.
VITE_MQTT_TOPIC_BASE=

# Opcional: broker MQTT de testes (WebSocket seguro). Vazio = broker EMQX Cloud original.
# Exemplo de EMQX Cloud Serverless próprio:
# VITE_MQTT_URL=wss://xxxxxxxx.ala.us-east-1.emqxsl.com:8084/mqtt
VITE_MQTT_URL=
